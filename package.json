{
  "name": "electroplan",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "generate": "prisma generate",
    "migrate": "tsx scripts/migrate.ts",
    "build": "npm run generate && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "tsx server/cli.ts backup",
    "restore": "tsx server/cli.ts restore",
    "license:sign": "tsx scripts/sign-license.ts",
    "format": "prettier --write server web scripts tests *.json *.ts prisma/schema.prisma --ignore-unknown"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "@prisma/client": "6.19.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.6.2",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "overrides": {
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.0"
  }
}
