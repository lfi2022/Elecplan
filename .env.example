DATA_DIR=./data
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_TOKEN=replace-with-a-long-random-secret
